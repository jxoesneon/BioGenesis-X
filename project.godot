; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BioGenesis-X"
config/description="AAA 3D Biopunk Procedural Starship Builder & Void Flight Simulator"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

HardwareDetector="*res://scripts/HardwareDetector.gd"
OrganTelemetry="*res://scripts/OrganTelemetry.gd"
BioManager="*res://scripts/BioManager.gd"
SaveSystem="*res://scripts/SaveSystem.gd"
BioAudioSynth="*res://scripts/BioAudioSynth.gd"
BioAudioDirector="*res://scripts/BioAudioDirector.gd"
PlanetDescentController="*res://scripts/PlanetDescentController.gd"
PlanetEntryManager="*res://scripts/PlanetEntryManager.gd"
DescentAudioController="*res://scripts/DescentAudioController.gd"
LandingSequenceController="*res://scripts/LandingSequenceController.gd"
ScaledSpaceManager="*res://scripts/ScaledSpaceManager.gd"
SettingsSystem="*res://scripts/SettingsSystem.gd"
GalacticNoiseField="*res://scripts/GalacticNoiseField.gd"
LoadingScreenManager="*res://scripts/LoadingScreenManager.gd"
CombatVFX="*res://scripts/CombatVFX.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[input]

interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":70,"physical_keycode":0,"key_label":0,"unicode":102,"location":0,"echo":false,"script":null)
]
}
abort_descent={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="JoltPhysics3D"
3d/default_gravity=0.0
3d/default_gravity_vector=Vector3(0, 0, 0)
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
common/physics_interpolation=true
3d/threading="multi_threaded"
jolt_physics3d/solver/enabled=true
jolt_physics3d/solver/solver_iterations=8

[rendering]

reflections/sky_reflections/roughness_layers=4
anti_aliasing/quality/msaa_3d=2
environment/volumetric_fog/use_filter=true
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_strategy=1
lights_and_shadows/positional_shadow/atlas_size_16bit=false
textures/vram_compression/import_etc2_ct=true

[threading]

worker_pool/low_priority_thread_count=6
load_async/threads_per_core=1
